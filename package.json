{
  "scripts": {
    "build": "bash build.sh",
    "build:win": "build.bat",
    "build:ps": "powershell -ExecutionPolicy Bypass -File build.ps1",
    "package": "bash package-all.sh",
    "package:win": "package-all.bat",
    "package:ps": "powershell -ExecutionPolicy Bypass -File package-all.ps1",
    "start:gateway": "cd gs-gateway && ../dist/bin/gs.exe main.gs",
    "start:agent": "cd gs-agent && ../dist/bin/gs.exe main.gs",
    "dev:gateway": "cd gs-gateway && gs main.gs",
    "dev:agent": "cd gs-agent && gs main.gs",
    "clean": "rm -rf dist && rm -f gts/gs.exe",
    "test": "cd gts && go test ./...",
    "test:gateway": "cd gs-gateway && gs smoke-test.gs"
  }
}
